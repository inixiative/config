{
  "name": "@inixiative/config",
  "version": "0.5.207",
  "description": "Shared toolchain and theme for the inixiative packages: tsconfig/biome/tsup presets, theme CSS, a version manifest (BOM), and a sync/check/train CLI",
  "type": "module",
  "license": "MIT",
  "author": "Aron Greenspan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/config.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "inixiative-config": "dist/cli.js"
  },
  "files": [
    "dist",
    "tsconfig",
    "biome",
    "lefthook",
    "theme",
    "versions.json",
    "README.md",
    "ports.json"
  ],
  "exports": {
    "./versions.json": "./versions.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./biome/base.json": "./biome/base.json",
    "./biome/react.json": "./biome/react.json",
    "./lefthook/base.yml": "./lefthook/base.yml",
    "./tsup": {
      "types": "./dist/tsup.d.ts",
      "import": "./dist/tsup.js"
    },
    "./ports.json": "./ports.json",
    "./theme/public.css": "./theme/public.css",
    "./theme/status.css": "./theme/status.css",
    "./theme/domains.css": "./theme/domains.css",
    "./theme/marketing.css": "./theme/marketing.css",
    "./theme/fonts/*": "./theme/fonts/*"
  },
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "1.4.4",
    "lefthook": "2.1.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.5.0",
    "tsup": ">=8.5.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "tsup": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
